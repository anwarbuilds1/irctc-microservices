# ==========================================
# Global Configuration
# ==========================================
NODE_ENV=production
JWT_SECRET=change-me-to-a-secure-random-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# Services Ports
# ==========================================
USER_SERVICE_PORT=3000
PGADMIN_PORT=5050
REDISINSIGHT_PORT=8001

# ==========================================
# Database Management GUI (pgAdmin)
# ==========================================
PGADMIN_DEFAULT_EMAIL=admin@irctc.com
PGADMIN_DEFAULT_PASSWORD=adminpassword

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password_here
POSTGRES_DB=user_db
POSTGRES_PORT=5432

# ==========================================
# Redis Cache Configuration
# ==========================================
REDIS_PASSWORD=secure_redis_password_here
REDIS_PORT=6379

# ==========================================
# RabbitMQ Message Broker Configuration
# ==========================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=secure_rabbitmq_password_here
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==========================================
# Resend Email Configuration
# ==========================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
